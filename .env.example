# URL do seu projeto no Supabase (Project Settings -> Data API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública do Supabase (Project Settings -> API Keys -> Publishable ou anon public)
# NUNCA coloque a chave service_role / secret aqui!
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-ou-anon-aqui
# Opcional: você também pode usar o nome legado VITE_SUPABASE_ANON_KEY no lugar da linha acima
# VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
